const markup = icons[name] ?? icons.check;
---

<svg class={`icon icon--${name} ${className}`} width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={markup}></svg>
