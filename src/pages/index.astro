---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

const phone = '5581984448760';
const whatsapp = `https://wa.me/${phone}?text=Olá!%20Quero%20pedir%20um%20frango%20crocante.`;

const products = [
  {
    badge: 'MAIS PEDIDO',
    name: 'Combo Frango Expresso',
    description: 'Frango crocante + batata + refrigerante + molho',
    price: 'R$ 32,90',
    image: '/images/hero-food.png',
    imageClass: 'product-image--combo',
  },
  {
    badge: 'SUCESSO',
    name: 'Frango Crocante',
    description: 'Pedaços suculentos e crocantes do nosso frango especial',
    price: 'R$ 24,90',
    image: '/images/chicken.png',
    imageClass: 'product-image--chicken',
  },
  {
    badge: 'LANÇAMENTO',
    name: 'Hambúrguer de Frango',
    description: 'Frango crocante, alface, tomate e molho especial',
    price: 'R$ 26,90',
    image: '/images/burger.png',
    imageClass: 'product-image--burger',
  },
  {
    badge: 'COMPLEMENTO',
    name: 'Batata com Molho',
    description: 'Batata crocante com o nosso molho especial',
    price: 'R$ 14,90',
    image: '/images/fries.png',
    imageClass: 'product-image--fries',
  },
];

const menuItems = [
  { name: 'Combo Frango Expresso', description: '4 pedaços de frango, batata, bebida e molho da casa.', price: 32.9, category: 'combos', categoryLabel: 'Combos', image: '/images/hero-food.png', imageClass: 'menu-image--combo', tag: 'Mais pedido' },
  { name: 'Combo Família', description: '8 pedaços crocantes, 2 batatas grandes, 4 molhos e 1 refrigerante de 1L.', price: 69.9, category: 'combos', categoryLabel: 'Combos', image: '/images/combo-family.png', imageClass: 'menu-image--family', tag: 'Para compartilhar' },
  { name: 'Frango Crocante', description: 'Pedaços suculentos com empanado dourado e crocante.', price: 24.9, category: 'frango', categoryLabel: 'Frango', image: '/images/chicken.png', imageClass: 'menu-image--chicken', tag: 'Clássico' },
  { name: 'Tiras Crocantes', description: 'Tiras de peito de frango empanadas, macias por dentro.', price: 22.9, category: 'frango', categoryLabel: 'Frango', image: '/images/chicken-strips.png', imageClass: 'menu-image--strips', tag: 'Sucesso' },
  { name: 'Hambúrguer de Frango', description: 'Pão brioche, frango crocante, alface, tomate e molho especial.', price: 26.9, category: 'hamburgueres', categoryLabel: 'Hambúrgueres', image: '/images/burger.png', imageClass: 'menu-image--burger', tag: 'Lançamento' },
  { name: 'Burger Cheddar Bacon', description: 'Frango crocante, cheddar cremoso, bacon e cebola crispy.', price: 29.9, category: 'hamburgueres', categoryLabel: 'Hambúrgueres', image: '/images/burger-cheddar-bacon.png', imageClass: 'menu-image--burger', tag: 'Novo' },
  { name: 'Batata com Molho', description: 'Batatas fininhas e douradas com o molho especial da casa.', price: 14.9, category: 'acompanhamentos', categoryLabel: 'Acompanhamentos', image: '/images/fries.png', imageClass: 'menu-image--fries', tag: 'Complemento' },
  { name: 'Batata Cheddar & Bacon', description: 'Batata crocante coberta com cheddar e bacon crocante.', price: 19.9, category: 'acompanhamentos', categoryLabel: 'Acompanhamentos', image: '/images/fries-cheddar-bacon.png', imageClass: 'menu-image--fries-large', tag: 'Favorito' },
  { name: 'Coca-Cola Lata', description: 'Lata gelada de 350 ml para acompanhar seu pedido.', price: 6.5, category: 'bebidas', categoryLabel: 'Bebidas', image: '/images/cola-can.png', imageClass: 'menu-image--drink', tag: 'Gelada' },
  { name: 'Suco de Laranja', description: 'Suco natural de laranja, servido bem gelado.', price: 8.9, category: 'bebidas', categoryLabel: 'Bebidas', image: '/images/orange-juice.png', imageClass: 'menu-image--drink', tag: 'Natural' },
  { name: 'Molho Cheddar', description: 'Porção individual do nosso cheddar cremoso.', price: 4.5, category: 'molhos', categoryLabel: 'Molhos', image: '/images/cheddar-sauce.png', imageClass: 'menu-image--sauce', tag: 'Cremoso' },
  { name: 'Molho Especial', description: 'Nossa maionese temperada, perfeita para mergulhar.', price: 3.5, category: 'molhos', categoryLabel: 'Molhos', image: '/images/special-sauce.png', imageClass: 'menu-image--sauce', tag: 'Da casa' },
];

const money = (value: number) => value.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });

const reviews = [
  { initials: 'RA', name: 'Rafael Almeida', quote: '“Simplesmente o melhor frango frito da região! Sempre chega quentinho e crocante. Virou rotina aqui em casa!”', tone: 'review-avatar--one' },
  { initials: 'JC', name: 'Juliana Costa', quote: '“Sabor incrível, porções generosas e entrega super rápida. Recomendo de olhos fechados!”', tone: 'review-avatar--two' },
  { initials: 'LP', name: 'Lucas Pereira', quote: '“O hambúrguer de frango é sensacional e a batata com molho é viciante. Qualidade sempre!”', tone: 'review-avatar--three' },
];

const benefits = [
  { icon: 'motorcycle', title: 'Entrega rápida', text: 'Seu frango quentinho e sem demora' },
  { icon: 'drumstick', title: 'Frango sempre crocante', text: 'Receitas exclusivas e muito mais sabor' },
  { icon: 'sauce', title: 'Molhos especiais', text: 'Sabores que fazem a diferença' },
  { icon: 'users', title: 'Mais de 600 mil clientes satisfeitos', text: 'Confiança que se prova no primeiro pedaço' },
];

const steps = [
  { number: '1', icon: 'whatsapp', title: 'Chame no WhatsApp', text: 'Clique no botão e fale com a nossa equipe.' },
  { number: '2', icon: 'shopping-bag', title: 'Monte sua sacola', text: 'Escolha seus itens e prepare seu pedido.' },
  { number: '3', icon: 'home', title: 'Receba em casa', text: 'Agora é só esperar e se deliciar com o melhor frango da região!' },
];

const stars = '★★★★★';
---

<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Frango Frito Expresso — crocante por fora, absurdo por dentro." />
    <title>Frango Frito Expresso | Crocante por fora</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a class="brand" href="#inicio" aria-label="Frango Frito Expresso — início">
          <img class="brand-logo" src="/images/logo.jpg" alt="" />
          <span class="brand-tagline">Mais que frango,<br /><b>é felicidade expressa!</b></span>
        </a>

        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav">
          <span></span><span></span><span></span>
          <span class="sr-only">Abrir menu</span>
        </button>

        <nav id="main-nav" class="main-nav" aria-label="Navegação principal">
          <a href="#cardapio-completo">Cardápio</a>
          <a href="#cardapio-completo">Combos</a>
          <a href="#promocoes">Promoções</a>
          <a href="#avaliacoes">Avaliações</a>
          <a href="#contato">Contato</a>
        </nav>

        <a class="button button--header" href={whatsapp} target="_blank" rel="noreferrer">
          <img class="whatsapp-img" src="/images/whatsapp-icon-white.png" alt="" /> Pedir Agora
        </a>
      </div>
    </header>

    <main id="inicio">
      <section class="hero section-texture">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow eyebrow--light">FRANGO FRITO EXPRESSO</p>
            <h1>CROCANTE<br /><span>POR FORA.</span><br /><strong>ABSURDO</strong><br /><span>POR DENTRO.</span></h1>
            <p class="hero-lead">O melhor frango frito da região, agora na sua casa!</p>
            <p class="hero-sublead">Combos deliciosos, molhos especiais e muito mais.</p>
            <div class="hero-actions">
              <a class="button button--yellow" href={whatsapp} target="_blank" rel="noreferrer"><img class="whatsapp-img" src="/images/whatsapp-icon-white.png" alt="" /> Pedir Agora <span><Icon name="arrow-right" size={19} strokeWidth={2.4} /></span></a>
              <a class="button button--outline" href="#cardapio-completo"><Icon name="utensils" size={18} /> Ver Cardápio</a>
            </div>
            <div class="hero-proof" aria-label="Diferenciais">
              <span><b><Icon name="motorcycle" size={24} strokeWidth={2.1} /></b><small>Entrega rápida<br />e segura</small></span>
              <span><b><Icon name="users" size={24} strokeWidth={2.1} /></b><small>Mais de 600 mil<br />clientes satisfeitos</small></span>
              <span><b><Icon name="heart" size={24} strokeWidth={2.1} /></b><small>Sabor que<br />conquista desde 2019</small></span>
            </div>
          </div>

          <div class="hero-art" aria-label="Combo de frango crocante com batata, bebida e molho">
            <div class="hero-art__halo"></div>
            <div class="hero-script hero-script--top">Aquele frango<br />que faz o dia<br />mais feliz!</div>
              <div class="hero-arrow">↘</div>
            <img class="hero-food" src="/images/hero-food.png" alt="Frango frito crocante, batatas, refrigerante e molho" />
            <div class="hero-sticker"><span><Icon name="crown" size={28} strokeWidth={2.2} /></span> FRANGO<br /><b>DE VERDADE</b><br />É AQUI!</div>
            <div class="hero-sticker hero-sticker--dark">SABOR<br />QUE VIRA<br /><b>ROTINA <Icon name="heart" size={16} strokeWidth={2.4} /></b></div>
          </div>
        </div>
      </section>

      <section id="cardapio" class="products section-cream">
        <div class="container">
          <div class="section-heading section-heading--products">
            <div>
              <p class="eyebrow eyebrow--brown">NOSSOS PRODUTOS</p>
              <h2>MAIS <em>PEDIDOS</em> <span class="scribble">⌁</span></h2>
            </div>
            <a class="text-link" href="#cardapio-completo">Ver todo o cardápio <Icon name="arrow-right" size={15} strokeWidth={2.2} /></a>
          </div>
          <div class="product-grid">
            {products.map((product) => (
              <article class="product-card">
                <div class="product-card__media">
                  <span class="badge">{product.badge}</span>
                  <img class={`product-image ${product.imageClass}`} src={product.image} alt={product.name} loading="lazy" />
                </div>
                <div class="product-card__body">
                  <h3>{product.name}</h3>
                  <p>{product.description}</p>
                  <strong class="price">{product.price}</strong>
                  <a class="button button--product" href={whatsapp} target="_blank" rel="noreferrer"><img class="whatsapp-img" src="/images/whatsapp-icon-white.png" alt="" /> Pedir Agora</a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="cardapio-completo" class="full-menu section-cream-light">
        <div class="container">
          <div class="full-menu-heading">
            <div>
              <p class="eyebrow eyebrow--brown">CARDÁPIO COMPLETO</p>
              <h2>ESCOLHA SEU <em>FAVORITO</em></h2>
              <p class="full-menu-intro">Monte seu pedido com os clássicos da casa, novidades e acompanhamentos.</p>
            </div>
            <div class="menu-status"><span class="status-dot"></span> Aberto hoje <b>11h às 23h</b></div>
          </div>

          <div class="menu-toolbar">
            <div class="category-tabs" role="tablist" aria-label="Categorias do cardápio">
              <button class="category-tab is-active" type="button" data-filter="all" role="tab" aria-selected="true">Todos</button>
              <button class="category-tab" type="button" data-filter="combos" role="tab" aria-selected="false">Combos</button>
              <button class="category-tab" type="button" data-filter="frango" role="tab" aria-selected="false">Frango</button>
              <button class="category-tab" type="button" data-filter="hamburgueres" role="tab" aria-selected="false">Hambúrgueres</button>
              <button class="category-tab" type="button" data-filter="acompanhamentos" role="tab" aria-selected="false">Acompanhamentos</button>
              <button class="category-tab" type="button" data-filter="bebidas" role="tab" aria-selected="false">Bebidas</button>
              <button class="category-tab" type="button" data-filter="molhos" role="tab" aria-selected="false">Molhos</button>
            </div>
            <button class="cart-inline-button" type="button" data-open-cart><Icon name="shopping-bag" size={18} /> Ver meu pedido <span id="cart-inline-count">0</span></button>
          </div>

          <div class="menu-grid" id="menu-grid">
            {menuItems.map((item) => (
              <article class="menu-item" data-category={item.category} data-name={item.name} data-price={item.price} data-image={item.image}>
                <div class="menu-item__media">
                  <span class="menu-tag">{item.tag}</span>
                  <span class="menu-category">{item.categoryLabel}</span>
                  <img class={`menu-image ${item.imageClass}`} src={item.image} alt={item.name} loading="lazy" />
                </div>
                <div class="menu-item__content">
                  <h3>{item.name}</h3>
                  <p>{item.description}</p>
                  <div class="menu-item__bottom"><strong>{money(item.price)}</strong><button class="menu-add" type="button" data-add-to-cart><span>+</span> Adicionar</button></div>
                </div>
              </article>
            ))}
          </div>
          <p class="menu-empty" id="menu-empty" hidden>Nenhum item encontrado nessa categoria.</p>
        </div>
      </section>

      <section id="promocoes" class="promo-banner section-texture">
        <div class="promo-banner__photo"><img src="/images/sauce-banner.png" alt="Frango crocante mergulhado em molho cremoso" loading="lazy" /></div>
        <div class="container promo-inner">
          <div class="promo-copy">
            <span class="promo-kicker">HOJE É DIA DE</span>
            <h2>PEDIR<br /><b>FRANGO</b></h2>
          </div>
          <div class="promo-aside">
            <p>Tá barato,<br />tá crocante e<br /><b>tá imperdível!</b></p>
            <a class="button button--dark" href={whatsapp} target="_blank" rel="noreferrer"><img class="whatsapp-img" src="/images/whatsapp-icon-white.png" alt="" /> Pedir pelo WhatsApp</a>
          </div>
          <div class="promo-script">Sabor<br />de outro<br />mundo! <span>↙</span></div>
        </div>
      </section>

      <section class="benefits section-cream-light">
        <div class="container benefit-grid">
          {benefits.map((benefit, index) => (
            <div class:list={["benefit", index === benefits.length - 1 ? 'benefit--wide-copy' : '']}>
              <span class="benefit-icon" aria-hidden="true"><Icon name={benefit.icon} size={32} strokeWidth={1.8} /></span>
              <div><h3>{benefit.title}</h3><p>{benefit.text}</p></div>
            </div>
          ))}
        </div>
      </section>

      <section id="avaliacoes" class="reviews section-cream">
        <div class="container">
          <div class="section-heading">
            <div><p class="eyebrow eyebrow--brown">O QUE NOSSOS</p><h2>CLIENTES <em>DIZEM</em> <span class="scribble">⌁</span></h2></div>
            <a class="text-link" href={whatsapp} target="_blank" rel="noreferrer">Ver mais avaliações <Icon name="arrow-right" size={15} strokeWidth={2.2} /></a>
          </div>
          <div class="review-grid">
            {reviews.map((review) => (
              <article class="review-card">
                <div class={`review-avatar ${review.tone}`}>{review.initials}</div>
                <div><div class="stars" aria-label="5 estrelas">{Array.from({ length: 5 }).map(() => <Icon name="star" size={14} strokeWidth={2.3} />)}</div><p>{review.quote}</p><strong>{review.name}</strong></div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="how-to section-dark">
        <div class="container">
          <p class="eyebrow eyebrow--light">SEM COMPLICAÇÃO</p>
          <h2>COMO <em>PEDIR?</em></h2>
          <p class="how-intro">É simples, rápido e delicioso!</p>
          <div class="steps-grid">
            {steps.map((step, index) => (
              <div class="step-wrap">
                <article class="step">
                  <span class="step-number">{step.number}</span>
                  <span class="step-icon" aria-hidden="true">{step.icon === 'whatsapp' ? <img class="step-whatsapp-img" src="/images/whatsapp-icon-white.png" alt="" /> : <Icon name={step.icon} size={31} strokeWidth={1.8} />}</span>
                  <h3>{step.title}</h3>
                  <p>{step.text}</p>
                </article>
                {index < steps.length - 1 && <span class="step-arrow" aria-hidden="true"><Icon name="arrow-right" size={42} strokeWidth={2.1} /></span>}
              </div>
            ))}
          </div>
          <p class="how-script">Do nosso<br />frango para<br />o seu dia! <span><Icon name="heart" size={26} strokeWidth={2.1} /></span></p>
        </div>
      </section>

      <section class="whatsapp-band section-yellow">
        <div class="container whatsapp-inner">
          <div class="whatsapp-copy"><strong>BATEU<br />A FOME?</strong><span>PEDE NO<br /><b>WHATSAPP!</b></span></div>
          <a class="phone-cta" href={whatsapp} target="_blank" rel="noreferrer">
            <span class="phone-icon"><img class="whatsapp-img" src="/images/whatsapp-icon-white.png" alt="" /></span>
            <span class="phone-cta__copy"><small>Peça pelo WhatsApp</small><strong>(81) 98444-8760</strong></span>
            <Icon name="arrow-right" size={20} strokeWidth={2.3} />
          </a>
          <div class="band-mascot"><img class="band-mascot__logo" src="/images/logo.jpg" alt="Frango Frito Expresso" /><b>SABOR<br />QUE APROXIMA<br />PESSOAS <Icon name="heart" size={16} strokeWidth={2.2} /></b></div>
        </div>
      </section>
    </main>

    <footer id="contato" class="site-footer section-dark">
      <div class="container footer-grid">
        <div class="footer-brand"><img class="brand-logo brand-logo--footer" src="/images/logo.jpg" alt="Frango Frito Expresso" /><p>Mais que frango,<br /><b>é felicidade expressa!</b></p></div>
        <div><h3>Links</h3><a href="#cardapio">Cardápio</a><a href="#cardapio">Combos</a><a href="#promocoes">Promoções</a><a href="#avaliacoes">Avaliações</a><a href="#contato">Contato</a></div>
        <div><h3>Atendimento</h3><a href={whatsapp} target="_blank" rel="noreferrer"><img class="whatsapp-img" src="/images/whatsapp-icon-white.png" alt="" /> (81) 98444-8760</a><a href="https://instagram.com/frangofritoexpresso" target="_blank" rel="noreferrer"><Icon name="instagram" size={14} /> @frangofritoexpresso</a><span><Icon name="map-pin" size={14} /> Recife, PE</span><a href="mailto:contato@frangofritoexpresso.com.br"><Icon name="mail" size={14} /> contato@frangofritoexpresso.com.br</a></div>
        <div><h3>Horário de funcionamento</h3><p><Icon name="clock" size={14} /> Todos os dias<br /><b>&nbsp;&nbsp;&nbsp;&nbsp;11h às 23h</b></p></div>
        <p class="footer-script">Frango<br />é sempre<br />uma boa ideia!<br /><span><Icon name="heart" size={22} strokeWidth={2.2} /></span></p>
      </div>
      <div class="container footer-bottom"><span>© 2024 Frango Frito Expresso. Todos os direitos reservados.</span><span>Feito com <b><Icon name="heart" size={12} strokeWidth={2.4} /> </b> no Brasil</span></div>
    </footer>

    <button class="cart-fab" type="button" data-open-cart aria-label="Abrir meu pedido">
      <Icon name="shopping-bag" size={22} />
      <span>Meu pedido</span>
      <b id="cart-count">0</b>
    </button>
    <div class="cart-backdrop" data-close-cart></div>
    <aside class="cart-drawer" id="cart-drawer" aria-hidden="true" aria-label="Meu pedido">
      <div class="cart-drawer__header">
        <div><p class="eyebrow eyebrow--brown">SEU PEDIDO</p><h2>Monte seu <em>combo</em></h2></div>
        <button class="cart-close" type="button" data-close-cart aria-label="Fechar pedido">×</button>
      </div>
      <div class="cart-drawer__body">
        <div class="cart-empty" id="cart-empty"><span><Icon name="shopping-bag" size={28} /></span><h3>Seu pedido está vazio</h3><p>Escolha seus favoritos no cardápio e adicione aqui.</p><button class="button button--cart-empty" type="button" data-close-cart>Ver cardápio</button></div>
        <div class="cart-items" id="cart-items"></div>
        <form class="delivery-form" id="delivery-form" hidden>
          <div class="delivery-form__heading">
            <div><p class="eyebrow eyebrow--brown">ÚLTIMA ETAPA</p><h3>Dados para <em>entrega</em></h3></div>
            <button class="delivery-back" id="delivery-back" type="button">Voltar</button>
          </div>
          <p class="delivery-form__intro">Preencha seus dados para enviarmos o pedido certinho pelo WhatsApp.</p>
          <div class="delivery-form__grid">
            <label>Nome completo *<input name="customerName" type="text" autocomplete="name" placeholder="Como podemos te chamar?" required /></label>
            <label>WhatsApp *<input name="customerPhone" type="tel" inputmode="tel" autocomplete="tel" placeholder="(81) 99999-9999" required /></label>
            <label class="delivery-form__wide">Rua ou avenida *<input name="street" type="text" autocomplete="street-address" placeholder="Ex.: Rua das Flores" required /></label>
            <label>Número da casa *<input name="houseNumber" type="text" inputmode="numeric" placeholder="Ex.: 123" required /></label>
            <label>Complemento <input name="complement" type="text" placeholder="Apto, bloco..." /></label>
            <label>Bairro *<input name="neighborhood" type="text" autocomplete="address-level3" placeholder="Seu bairro" required /></label>
            <label>Cidade/UF *<input name="cityState" type="text" autocomplete="address-level2" value="Recife - PE" required /></label>
            <label class="delivery-form__wide">Ponto de referência <input name="reference" type="text" placeholder="Ex.: perto da praça" /></label>
            <label>Forma de pagamento *
              <select name="payment" required>
                <option value="" selected disabled>Selecione</option>
                <option>Pix</option>
                <option>Dinheiro</option>
                <option>Cartão na entrega</option>
              </select>
            </label>
            <label>Troco para <input name="changeFor" type="text" inputmode="decimal" placeholder="Ex.: R$ 50,00" /></label>
            <label class="delivery-form__wide">Observações do pedido <textarea name="notes" rows="2" placeholder="Alguma observação para a cozinha ou entrega?"></textarea></label>
          </div>
        </form>
      </div>
      <div class="cart-drawer__footer">
        <div class="cart-total"><span>Total do pedido</span><strong id="cart-total">R$ 0,00</strong></div>
        <button class="button button--checkout" id="cart-checkout" type="button" disabled>Continuar para entrega <Icon name="arrow-right" size={17} strokeWidth={2.3} /></button>
        <button class="button button--checkout button--send-order" id="cart-send-order" type="submit" form="delivery-form" hidden><img class="whatsapp-img" src="/images/whatsapp-icon-white.png" alt="" /> Enviar pedido pelo WhatsApp</button>
        <small id="cart-checkout-note">Você informa o endereço e pagamento antes de enviar.</small>
      </div>
    </aside>

    <script>
      const whatsappPhone = '5581984448760';
      const menuToggle = document.querySelector('.menu-toggle');
      const nav = document.querySelector('#main-nav');
      menuToggle?.addEventListener('click', () => {
        const isOpen = document.body.classList.toggle('menu-open');
        menuToggle.setAttribute('aria-expanded', String(isOpen));
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
        document.body.classList.remove('menu-open');
        menuToggle?.setAttribute('aria-expanded', 'false');
      }));

      const filterTabs = [...document.querySelectorAll('[data-filter]')];
      const menuCards = [...document.querySelectorAll('.menu-item')];
      const menuEmpty = document.querySelector('#menu-empty');
      filterTabs.forEach((tab) => tab.addEventListener('click', () => {
        const filter = tab.dataset.filter;
        filterTabs.forEach((item) => {
          const active = item === tab;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-selected', String(active));
        });
        let visible = 0;
        menuCards.forEach((card) => {
          const show = filter === 'all' || card.dataset.category === filter;
          card.hidden = !show;
          if (show) visible += 1;
        });
        if (menuEmpty) menuEmpty.hidden = visible > 0;
      }));

      const cart = new Map();
      const cartDrawer = document.querySelector('#cart-drawer');
      const cartItems = document.querySelector('#cart-items');
      const cartEmpty = document.querySelector('#cart-empty');
      const cartTotal = document.querySelector('#cart-total');
      const cartCount = document.querySelector('#cart-count');
      const cartInlineCount = document.querySelector('#cart-inline-count');
      const checkoutButton = document.querySelector('#cart-checkout');
      const sendOrderButton = document.querySelector('#cart-send-order');
      const checkoutNote = document.querySelector('#cart-checkout-note');
      const deliveryForm = document.querySelector('#delivery-form');
      const deliveryBack = document.querySelector('#delivery-back');
      const formatCurrency = (value) => new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' }).format(value);
      const totalQuantity = () => [...cart.values()].reduce((sum, item) => sum + item.quantity, 0);

      const showCartSummary = () => {
        if (deliveryForm) deliveryForm.hidden = true;
        if (checkoutButton) checkoutButton.hidden = false;
        if (sendOrderButton) sendOrderButton.hidden = true;
        if (checkoutNote) checkoutNote.textContent = 'Você informa o endereço e pagamento antes de enviar.';
      };

      const showDeliveryForm = () => {
        if (!cart.size) return;
        if (deliveryForm) deliveryForm.hidden = false;
        if (checkoutButton) checkoutButton.hidden = true;
        if (sendOrderButton) sendOrderButton.hidden = false;
        if (checkoutNote) checkoutNote.textContent = 'Confira os dados antes de enviar seu pedido.';
        deliveryForm?.querySelector('input')?.focus();
      };

      const renderCart = () => {
        const items = [...cart.values()];
        const quantity = totalQuantity();
        if (cartCount) cartCount.textContent = String(quantity);
        if (cartInlineCount) cartInlineCount.textContent = String(quantity);
        if (cartEmpty) cartEmpty.hidden = items.length > 0;
        if (checkoutButton) checkoutButton.disabled = items.length === 0;
        if (sendOrderButton) sendOrderButton.disabled = items.length === 0;
        if (!items.length) showCartSummary();
        if (cartItems) {
          cartItems.innerHTML = items.map((item) => `
            <div class="cart-line">
              <img src="${item.image}" alt="${item.name}" />
              <div class="cart-line__info">
                <strong>${item.name}</strong>
                <span>${formatCurrency(item.price)}</span>
                <div class="cart-line__controls">
                  <button type="button" data-cart-action="decrease" data-cart-name="${item.name}" aria-label="Diminuir ${item.name}">−</button>
                  <b>${item.quantity}</b>
                  <button type="button" data-cart-action="increase" data-cart-name="${item.name}" aria-label="Aumentar ${item.name}">+</button>
                  <button class="cart-remove" type="button" data-cart-action="remove" data-cart-name="${item.name}"><span class="cart-remove__icon" aria-hidden="true">×</span> Remover item</button>
                </div>
              </div>
            </div>`).join('');
        }
        const total = items.reduce((sum, item) => sum + item.price * item.quantity, 0);
        if (cartTotal) cartTotal.textContent = formatCurrency(total);
      };

      const openCart = () => {
        document.body.classList.add('cart-open');
        cartDrawer?.setAttribute('aria-hidden', 'false');
      };
      const closeCart = () => {
        document.body.classList.remove('cart-open');
        cartDrawer?.setAttribute('aria-hidden', 'true');
      };
      document.querySelectorAll('[data-open-cart]').forEach((button) => button.addEventListener('click', openCart));
      document.querySelectorAll('[data-close-cart]').forEach((button) => button.addEventListener('click', closeCart));
      checkoutButton?.addEventListener('click', showDeliveryForm);
      deliveryBack?.addEventListener('click', showCartSummary);

      document.querySelectorAll('[data-add-to-cart]').forEach((button) => button.addEventListener('click', () => {
        const card = button.closest('.menu-item');
        if (!card) return;
        const name = card.dataset.name || 'Item do cardápio';
        const current = cart.get(name);
        cart.set(name, {
          name,
          image: card.dataset.image || '/images/chicken.png',
          price: Number(card.dataset.price || 0),
          quantity: current ? current.quantity + 1 : 1,
        });
        renderCart();
      }));

      cartItems?.addEventListener('click', (event) => {
        const actionButton = event.target.closest('[data-cart-action]');
        if (!actionButton) return;
        const name = actionButton.dataset.cartName;
        const item = cart.get(name);
        if (!item) return;
        if (actionButton.dataset.cartAction === 'remove') cart.delete(name);
        if (actionButton.dataset.cartAction === 'increase') item.quantity += 1;
        if (actionButton.dataset.cartAction === 'decrease') {
          item.quantity -= 1;
          if (item.quantity <= 0) cart.delete(name);
        }
        renderCart();
      });

      deliveryForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        if (!cart.size || !deliveryForm.reportValidity()) return;
        const formData = new FormData(deliveryForm);
        const lines = [...cart.values()].map((item) => `${item.quantity}x ${item.name} — ${formatCurrency(item.price * item.quantity)}`).join('\n');
        const total = [...cart.values()].reduce((sum, item) => sum + item.price * item.quantity, 0);
        const getValue = (name) => String(formData.get(name) || '').trim();
        const message = [
          'Olá! Quero fazer este pedido:',
          lines,
          '',
          `Total: ${formatCurrency(total)}`,
          '',
          'DADOS PARA ENTREGA',
          `Nome: ${getValue('customerName')}`,
          `WhatsApp: ${getValue('customerPhone')}`,
          `Endereço: ${getValue('street')}, nº ${getValue('houseNumber')}`,
          `Complemento: ${getValue('complement') || 'Não informado'}`,
          `Bairro: ${getValue('neighborhood')}`,
          `Cidade/UF: ${getValue('cityState')}`,
          `Referência: ${getValue('reference') || 'Não informado'}`,
          `Pagamento: ${getValue('payment')}`,
          `Troco para: ${getValue('changeFor') || 'Não se aplica'}`,
          `Observações: ${getValue('notes') || 'Nenhuma'}`,
        ].join('\n');
        window.open(`https://wa.me/${whatsappPhone}?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeCart();
      });
      renderCart();
    </script>
  </body>
</html>
